{
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "properties": {
          "action": {
            "enum": [
              "approve",
              "edit",
              "reject"
            ],
            "title": "Action",
            "type": "string"
          },
          "cover_letter": {
            "anyOf": [
              {
                "maxLength": 20000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cover Letter"
          },
          "reason": {
            "default": "",
            "maxLength": 2000,
            "title": "Reason",
            "type": "string"
          },
          "review_hash": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Review Hash",
            "type": "string"
          },
          "screening_answers": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ScreeningAnswer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screening Answers"
          }
        },
        "required": [
          "action",
          "review_hash"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "const": "gigbid-api",
            "default": "gigbid-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "postgres": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Postgres",
            "type": "string"
          },
          "redis": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Redis",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "postgres",
          "redis"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ReplayRequest": {
        "properties": {
          "checkpoint_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Checkpoint Id",
            "type": "string"
          },
          "node": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Node",
            "type": "string"
          }
        },
        "required": [
          "checkpoint_id",
          "node"
        ],
        "title": "ReplayRequest",
        "type": "object"
      },
      "RunDetail": {
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "review": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review"
          },
          "state": {
            "additionalProperties": true,
            "title": "State",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "target",
          "status",
          "trace_id",
          "attempts",
          "state"
        ],
        "title": "RunDetail",
        "type": "object"
      },
      "RunSummary": {
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "target",
          "status",
          "trace_id",
          "attempts"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "ScreeningAnswer": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Answer",
            "type": "string"
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer"
        ],
        "title": "ScreeningAnswer",
        "type": "object"
      },
      "StartRun": {
        "properties": {
          "kind": {
            "enum": [
              "bid",
              "conversation"
            ],
            "title": "Kind",
            "type": "string"
          },
          "target": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "target"
        ],
        "title": "StartRun",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "GigBid API",
