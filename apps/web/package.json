    "react": "19.3.1",
    "react-dom": "19.3.1",
    "openapi-fetch": "0.15.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
