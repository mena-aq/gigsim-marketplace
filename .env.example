APP_ENV=development
APP_SECRET_KEY=replace_me
DATABASE_URL=postgresql+asyncpg://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=replace_me
MODEL_PROFILE=open
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Phase 0: data generation -------------------------------------------------
# Used by data/scripts/download.py (from kaggle.com/settings/api -> Generate New Token)
KAGGLE_API_TOKEN=
# Used by data/scripts/process.py and data/scripts/generate_personas.py.
# auto = local Ollama, then Groq if GROQ_API_KEY is set, then canned fallbacks.
# Pin with ollama | groq | none.
DATA_LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=300
# Optional per-run prompt+completion token cap (stops cleanly, rerun to resume)
LLM_TOKEN_BUDGET=180000
LLM_MIN_INTERVAL_SECONDS=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low keeps reasoning tokens (which count against Groq's 200K daily cap) small
GROQ_REASONING_EFFORT=low

# --- GigSim (simulated marketplace, owns its own Postgres on port 5433) --------
GIGSIM_DATABASE_URL=postgresql+asyncpg://gigsim:gigsim@localhost:5433/gigsim
GIGSIM_ADMIN_TOKEN=gigsim-admin-token
# One hardcoded test token per freelancer persona
GIGSIM_TOKEN_ML_ENGINEER=test-token-ml-engineer
GIGSIM_TOKEN_FULLSTACK_DEV=test-token-fullstack-dev
GIGSIM_TOKEN_DATA_ANALYST=test-token-data-analyst
GIGSIM_RATE_LIMIT_PER_MINUTE=60
GIGSIM_CHAOS_ENABLED=true
GIGSIM_CHAOS_ERROR_RATE=0.05
GIGSIM_REPLY_DELAY_MIN_SECONDS=5
GIGSIM_REPLY_DELAY_MAX_SECONDS=30
GIGSIM_INITIAL_CONNECTS=60

# --- GigBid foundation (host defaults; Compose overrides network addresses) ---
POSTGRES_USER=gigbid
POSTGRES_PASSWORD=gigbid
POSTGRES_DB=gigbid
API_INTERNAL_URL=http://localhost:8000
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Owned MCP servers (three different tokens, at least 24 characters each).
# Generate each locally: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_TOKEN_ML_ENGINEER=
MCP_TOKEN_FULLSTACK_DEV=
MCP_TOKEN_DATA_ANALYST=
MCP_PERSONA_DIR=data/personas
MCP_REQUESTS_PER_MINUTE=20
MCP_TIMEOUT_SECONDS=10
PORTFOLIO_MCP_URL=http://localhost:8101/mcp
MARKETPLACE_MCP_URL=http://localhost:8102/mcp
WORKSPACE_MCP_URL=http://localhost:8103/mcp

# RAG artifacts are generated/ignored; all model choices live in agent/config.yaml.
RAG_DATA_DIR=data/processed/rag

# Read-only RAG tools can take longer than marketplace calls on CPU.
MCP_CALL_TIMEOUT_SECONDS=600
